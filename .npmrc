# Install a flat, npm-style node_modules instead of pnpm's symlinked layout.
# Required for AWS Amplify SSR (Web Compute): its Next.js runtime bundles each
# app's node_modules and needs the real `next` package present there, not a
# symlink into pnpm's store. Without this the deploy fails with
# "The 'node_modules' folder is missing the 'next' dependency".
node-linker=hoisted
