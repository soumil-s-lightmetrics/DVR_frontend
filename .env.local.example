# Optional — nothing needs setting. Without a .env.local:
#   npm run dev    -> Flask on localhost:8080
#   npm run build  -> the Railway backend
# (see next.config.mjs). Copy to .env.local and uncomment only to point
# somewhere else, e.g. a Railway preview environment.

# HTTP backend for the /:fleet/load-data, /health and /static rewrites.
# BACKEND_URL=http://localhost:8080

# WebSocket for chat. Built into the page code, so changing it needs a rebuild.
# NEXT_PUBLIC_WS_URL=ws://localhost:8080/chat
