# Copy to .env.local for local dev. The Flask backend (main-DVR.py) runs on :8000.
# WebSocket: Next can't proxy ws through rewrites, so point it straight at Flask.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/chat
# HTTP proxy target for next.config.mjs rewrites (/:fleet/load-data, /health, /images, /static).
BACKEND_URL=http://localhost:8000
