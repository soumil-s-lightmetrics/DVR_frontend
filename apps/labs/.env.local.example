# Copy to .env.local for local dev. Never commit real secrets (.env*.local is git-ignored).

# Auth (whole site gated via middleware.ts). An external system mints an RS256
# access token and lands users at /auth/master-login?access_token=<jwt>; that
# route handler verifies it against AUTH_ISSUER/AUTH_AUDIENCE/AUTH_JWKS_URI
# and sets an httpOnly session cookie, which middleware re-verifies on every
# request. No NEXT_PUBLIC_ prefix needed — verification is server-side only.
AUTH_ISSUER=https://your-issuer.example.com
AUTH_AUDIENCE=your-audience
AUTH_JWKS_URI=https://your-issuer.example.com/.well-known/jwks.json
# Where middleware sends users with no valid session.
AUTH_LOGIN_URL=https://your-login-portal.example.com
# Uncomment to skip the auth check entirely for local testing (dev-only —
# ignored automatically outside NODE_ENV=development, see middleware.ts).
# SKIP_AUTH=true

# Dashcam Mount Analyzer (/mounting-verification -> /api/analyze), server-side only.
GEMINI_API_KEY=your-google-generative-ai-key
GEMINI_MODEL=gemini-3-flash-preview

# DVR Assistant (/dvr-request-flow). Flask backend (main-DVR.py) runs on :8000.
# WebSocket can't be proxied by Next rewrites, so point it straight at Flask.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/chat
# HTTP proxy target for next.config rewrites (/:fleet/load-data, /health, /static).
BACKEND_URL=http://localhost:8000

# Video Intelligence (/video-intelligence). Shared password for the embedded
# videorag.sdo.lightmetrics.co portal, posted into its iframe on load so users
# who already passed the auth gate above don't see a second login. This ships
# in the client bundle (NEXT_PUBLIC_*) — it is not actually secret once set.
NEXT_PUBLIC_VIDEORAG_SHARED_PASSWORD=your-shared-password

# Agentic LISA (/agentic-lisa). Iframed chatbot URL, includes its own access
# token as a query param. This ships in the client bundle (NEXT_PUBLIC_*) — it
# is not actually secret once set.
NEXT_PUBLIC_AGENTIC_LISA_CHATBOT_URL=https://api.lightmetrics.co:10473/chatbot?token=your-token

# MCP data chat (/mcp/chat -> /api/mcp-chat/*). FastAPI backend hosted on a
# Lambda Function URL (RESPONSE_STREAM mode) - see mcp-trial/backend/README.md.
# Both server-side only; the route handlers under app/api/mcp-chat proxy to
# this so the key never reaches the browser. MCP_CHAT_BACKEND_URL is also used
# to mint short-lived stream tokens (see NEXT_PUBLIC_MCP_CHAT_BACKEND_URL).
MCP_CHAT_BACKEND_URL=https://your-function-url.lambda-url.<region>.on.aws
MCP_CHAT_AUTH_KEY=your-proxy-auth-key

# Same Lambda Function URL as above, but public - the browser calls it
# directly for the streaming POST .../messages request (using a short-lived
# token minted via /api/mcp-chat/conversations/[id]/stream-token) so a slow
# chat turn isn't cut off by Amplify Hosting's fixed 30s SSR response
# timeout. This ships in the client bundle (NEXT_PUBLIC_*) - it is just a
# URL, not a secret.
NEXT_PUBLIC_MCP_CHAT_BACKEND_URL=https://your-function-url.lambda-url.<region>.on.aws
